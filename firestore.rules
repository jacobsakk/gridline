rules_version = '2';

// Invite-only. A coach can read or write data only when they are signed in
// (via the emailed sign-in link, which proves they own the address) AND there
// is an "accounts" document whose id is their lowercased email -- that
// document is the invitation. The owner below is always allowed, which is how
// the first account gets bootstrapped.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function myEmail() {
      return request.auth.token.email.lower();
    }
    function isOwner() {
      return signedIn() && myEmail() == 'sakk1j@cmich.edu';
    }
    function invited() {
      return isOwner() || (signedIn() && exists(/databases/$(database)/documents/accounts/$(myEmail())));
    }
    function isAdmin() {
      return isOwner() || (invited() && get(/databases/$(database)/documents/accounts/$(myEmail())).data.admin == true);
    }

    // The invite list. The sign-in page has to check "is this email invited?"
    // before anyone is signed in, so a single document can be fetched by its
    // id -- but the list itself can't be browsed, and only admins change it.
    // Coaches may stamp their own last-sign-in time and mark that they've set a
    // password, and nothing else.
    match /accounts/{email} {
      allow get: if true;
      allow list: if invited();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        signedIn() && myEmail() == email &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastLoginAt', 'passwordSet'])
      );
    }
    // "Request access" on the sign-in page -- open to the public (no signedIn() check) since the whole
    // point is that someone without an account yet can ask for one. Deliberately narrow: a create can
    // only plant a pending request under the submitter's OWN email (doc id must match the email field)
    // with exactly these fields and status always "pending" -- nothing here can grant real access on its
    // own. Only an admin can read the list, flip it to approved (which is really just them separately
    // creating the real accounts/{email} doc), or delete a request (denying it, or clearing it out after
    // approving).
    match /accountRequests/{email} {
      allow create: if request.resource.data.email == email &&
        request.resource.data.status == 'pending' &&
        request.resource.data.keys().hasOnly(['name', 'email', 'role', 'note', 'status', 'createdAt']);
      allow read, delete: if isAdmin();
    }

    match /watchlist/{docId} {
      allow read, write: if invited();
    }
    match /portalStatus/{docId} {
      allow read, write: if invited();
    }
    match /offers/{docId} {
      allow read, write: if invited();
    }
    // One doc per team, stamped by importWorkbook every time that team's sheet is recognized in an
    // upload -- backs the Offer Tracker's Assignments tab ("when did someone last upload this team's
    // board?"). Same access as offers itself: any invited coach can upload, so any invited coach can
    // write this.
    match /teamUploads/{docId} {
      allow read, write: if invited();
    }
    // Who's assigned to each team's board, overriding TEAM_ASSIGNMENTS' hand-maintained default when
    // someone edits it from the Assignments tab. Same access as offers/teamUploads.
    match /teamAssignments/{docId} {
      allow read, write: if invited();
    }
    // Stats loaded by hand for divisions the scrapers can't reach (NAIA, California JUCO).
    match /statsUploads/{docId} {
      allow read, write: if invited();
    }
    match /hsPlayers/{docId} {
      allow read, write: if invited();
    }
    // Scraped scores per school. Written only by the scheduled scraper (its
    // service account bypasses rules); coaches can read but not change them.
    match /hsTeams/{docId} {
      allow read: if invited();
    }

    // Roster Management. Every invited coach can view the roster and depth charts; only admins change them.
    match /rosterPlayers/{docId} {
      allow read: if invited();
      allow write: if isAdmin();
    }
    match /rosterSeasons/{docId} {
      allow read: if invited();
      allow write: if isAdmin();
    }
    match /rosterMeta/{docId} {
      allow read: if invited();
      allow write: if isAdmin();
    }
    // Revenue share dollars and athletes' contact details: admins only, for reading as well as writing.
    match /rosterFinance/{docId} {
      allow read, write: if isAdmin();
    }
    match /rosterPrivate/{docId} {
      allow read, write: if isAdmin();
    }

    // Maps: the area-coach color legend and the county -> coach assignments. Every invited coach can view
    // the map; only admins add/edit coaches or repaint counties.
    match /areaCoaches/{docId} {
      allow read: if invited();
      allow write: if isAdmin();
    }
    match /areaAssignments/{docId} {
      allow read: if invited();
      allow write: if isAdmin();
    }
    // Studies: a hand-edited field (a Hudl link a study's own data pull couldn't find) layered on top of
    // the study's bundled JSON. Every invited coach can view AND edit -- studies are a shared workspace,
    // not an admin-only one.
    match /studyOverrides/{docId} {
      allow read, write: if invited();
    }
    // A manual group's actual rows (Offensive Line, which has no stat source to pull from at all --
    // see studiesData.js), not a correction layered on top of one like studyOverrides above. Same
    // access as studyOverrides: every invited coach can view and edit.
    match /studyManualRows/{docId} {
      allow read, write: if invited();
    }
    // Transfer Out Tracker: a hand-maintained weekly log (no scraper source exists for a transfer's
    // per-week performance across every destination school), so every field on every row is typed in
    // by hand -- same access as studyManualRows above, any invited coach can edit.
    match /transferOutPlayers/{docId} {
      allow read, write: if invited();
    }
    // Single doc holding how many week columns the tracker currently shows (weekCount) -- bumped by any
    // invited coach's "+ Add week" click as the season goes on.
    match /transferOutMeta/{docId} {
      allow read, write: if invited();
    }
    // "Request a study" on the Studies page -- any invited coach can ask (optionally with an example
    // file, uploaded to Storage separately -- see storage.rules), only admins see and manage the queue.
    // Mirrors accountRequests' shape/intent: the request itself grants nothing, it just lands somewhere
    // visible instead of only in a chat with Claude.
    match /studyRequests/{docId} {
      allow create: if invited() &&
        request.resource.data.keys().hasOnly(['title', 'description', 'fileUrl', 'fileName', 'by', 'status', 'createdAt']) &&
        request.resource.data.status == 'pending' &&
        request.resource.data.by == myEmail();
      allow read, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
